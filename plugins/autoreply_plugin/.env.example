# Safe default: generate preview files only. No email is sent.
AUTOREPLY_LIVE_SEND=0

# Gmail SMTP defaults. For Gmail, use an App Password, not your normal password.
AUTOREPLY_SMTP_HOST=smtp.gmail.com
AUTOREPLY_SMTP_PORT=465
AUTOREPLY_SMTP_SSL=1
AUTOREPLY_SMTP_STARTTLS=0
AUTOREPLY_SMTP_USERNAME=your_account@gmail.com
AUTOREPLY_SMTP_PASSWORD=your_app_password
AUTOREPLY_FROM_ADDRESS=your_account@gmail.com

# Optional custom runtime folder
# AUTOREPLY_DATA_DIR=C:\\path\\to\\autoreply_runtime
